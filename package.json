{
  "name": "nexo-sound",
  "version": "2.1.0",
  "description": "NEXO SOUND — Premium desktop audio booster and equalizer for Windows and Linux",
  "main": "main.js",
  "bin": {
    "nexo-sound": "./bin/nexo-sound.js"
  },
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "build": "electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "express": "^4.21.0"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "jimp": "^1.6.1",
    "png-to-ico": "^3.0.2"
  },
  "build": {
    "appId": "com.nexosound.app",
    "productName": "NEXO SOUND",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon.png",
      "category": "AudioVideo"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "keywords": [
    "audio",
    "volume",
    "booster",
    "equalizer",
    "windows",
    "linux",
    "pulseaudio",
    "pipewire",
    "equalizer-apo"
  ],
  "author": "NEXO SOUND",
  "license": "MIT"
}
